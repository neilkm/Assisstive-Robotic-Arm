#!/usr/bin/env python3
"""Terminal system monitor for Jetson/Linux server sessions."""

from __future__ import annotations

import curses
import curses.textpad
import datetime as dt
import getpass
import glob
import os
import platform
import re
import shutil
import socket
import subprocess
import time
from dataclasses import dataclass
from typing import Iterable


REFRESH_SECONDS = 1.0


@dataclass(frozen=True)
class SshConnection:
    local: str
    remote: str
    process: str


def run_command(args: list[str], timeout: float = 0.8) -> str:
    try:
        completed = subprocess.run(
            args,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return ""
    return completed.stdout.strip()


def read_text(path: str) -> str:
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def format_bytes(kib: int | None) -> str:
    if kib is None:
        return "unknown"
    mib = kib / 1024
    if mib >= 1024:
        return f"{mib / 1024:.1f} GiB"
    return f"{mib:.0f} MiB"


def get_memory() -> dict[str, str]:
    meminfo: dict[str, int] = {}
    for line in read_text("/proc/meminfo").splitlines():
        parts = line.split()
        if len(parts) >= 2:
            meminfo[parts[0].rstrip(":")] = int(parts[1])

    if meminfo:
        total = meminfo.get("MemTotal")
        available = meminfo.get("MemAvailable")
        used = total - available if total is not None and available is not None else None
        percent = f"{used / total * 100:.1f}%" if used is not None and total else "unknown"
        swap_total = meminfo.get("SwapTotal")
        swap_free = meminfo.get("SwapFree")
        swap_used = (
            swap_total - swap_free
            if swap_total is not None and swap_free is not None
            else None
        )
        return {
            "RAM": f"{format_bytes(used)} / {format_bytes(total)} ({percent})",
            "Available": format_bytes(available),
            "Swap": f"{format_bytes(swap_used)} / {format_bytes(swap_total)}",
        }

    total_bytes = run_command(["sysctl", "-n", "hw.memsize"])
    if total_bytes.isdigit():
        total_kib = int(total_bytes) // 1024
        return {"RAM": format_bytes(total_kib), "Available": "unknown", "Swap": "unknown"}
    return {"RAM": "unknown", "Available": "unknown", "Swap": "unknown"}


def get_load() -> str:
    loadavg = read_text("/proc/loadavg")
    if loadavg:
        parts = loadavg.split()
        if len(parts) >= 3:
            return f"{parts[0]}  {parts[1]}  {parts[2]}"
    return run_command(["uptime"]).replace("load averages:", "load avg:")


def get_uptime() -> str:
    uptime = read_text("/proc/uptime")
    if uptime:
        seconds = int(float(uptime.split()[0]))
        days, rem = divmod(seconds, 86400)
        hours, rem = divmod(rem, 3600)
        minutes, _ = divmod(rem, 60)
        if days:
            return f"{days}d {hours}h {minutes}m"
        return f"{hours}h {minutes}m"
    return "unknown"


def get_primary_ip() -> str:
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        probe.connect(("8.8.8.8", 80))
        ip = probe.getsockname()[0]
        probe.close()
        return ip
    except OSError:
        pass

    hostname_ips = run_command(["hostname", "-I"])
    if hostname_ips:
        return hostname_ips.split()[0]
    try:
        return socket.gethostbyname(socket.gethostname())
    except OSError:
        return "unknown"


def get_identity() -> dict[str, str]:
    hostname = socket.gethostname()
    return {
        "Host": hostname,
        "Current user@ip": f"{getpass.getuser()}@{get_primary_ip()}",
        "OS": f"{platform.system()} {platform.release()}",
        "Uptime": get_uptime(),
    }


def parse_ss_line(line: str) -> SshConnection | None:
    parts = line.split()
    if len(parts) < 5 or parts[0] != "ESTAB":
        return None
    local = parts[3]
    remote = parts[4]
    if not any(token in local or token in remote for token in (":22", ":ssh")):
        return None
    process_match = re.search(r'users:\(\("([^"]+)"', line)
    return SshConnection(local=local, remote=remote, process=process_match.group(1) if process_match else "")


def get_ssh_connections() -> list[SshConnection]:
    output = run_command(["ss", "-tnp"], timeout=0.8)
    connections = [conn for conn in (parse_ss_line(line) for line in output.splitlines()) if conn]
    if connections:
        return connections

    output = run_command(["netstat", "-tnp"], timeout=0.8)
    parsed: list[SshConnection] = []
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 6 and parts[0].startswith("tcp") and parts[5] == "ESTABLISHED":
            local, remote = parts[3], parts[4]
            if any(token in local or token in remote for token in (":22", ":ssh")):
                parsed.append(SshConnection(local=local, remote=remote, process=parts[-1]))
    return parsed


def get_logged_in_users() -> list[str]:
    output = run_command(["who"], timeout=0.8)
    rows: list[str] = []
    for line in output.splitlines():
        rows.append(" ".join(line.split()))
    return rows


def get_power_mode() -> str:
    output = run_command(["nvpmodel", "-q"], timeout=1.5)
    if not output:
        return "unknown"
    for line in output.splitlines():
        if "NV Power Mode" in line or "Power Mode" in line:
            return line.strip()
    return output.splitlines()[0].strip()


def parse_milliwatts(raw: str) -> float | None:
    try:
        value = float(raw.strip())
    except ValueError:
        return None
    if value > 100000:
        return value / 1000000.0
    if value > 1000:
        return value / 1000.0
    return value


def get_power_draw() -> str:
    power_paths = []
    for pattern in (
        "/sys/bus/i2c/drivers/ina3221x/*/iio_device/in_power*_input",
        "/sys/bus/i2c/devices/*/iio_device/in_power*_input",
    ):
        power_paths.extend(glob.glob(pattern))

    readings = [parse_milliwatts(read_text(path)) for path in sorted(set(power_paths))]
    watts = [reading for reading in readings if reading is not None and reading > 0]
    if watts:
        return f"{sum(watts):.2f} W"

    tegrastats = run_command(["tegrastats", "--interval", "100", "--count", "1"], timeout=1.0)
    match = re.search(r"VDD_IN\s+(\d+)mW", tegrastats)
    if match:
        return f"{int(match.group(1)) / 1000:.2f} W"
    return "unknown"


def get_temperatures() -> list[str]:
    rows: list[str] = []
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
        name = read_text(os.path.join(zone, "type")) or os.path.basename(zone)
        raw_temp = read_text(os.path.join(zone, "temp"))
        if raw_temp.lstrip("-").isdigit():
            temp_c = int(raw_temp) / 1000.0
            rows.append(f"{name}: {temp_c:.1f} C")
    return rows[:6]


def get_disk() -> str:
    usage = shutil.disk_usage("/")
    used = usage.used / usage.total * 100
    return f"{usage.used // (1024**3)} / {usage.total // (1024**3)} GiB ({used:.1f}%)"


def get_process_snapshot() -> list[str]:
    output = run_command(["ps", "-eo", "pid,user,pcpu,pmem,comm", "--sort=-pcpu"], timeout=0.8)
    lines = output.splitlines()
    return [" ".join(line.split()) for line in lines[:8]]


def draw_box(stdscr: curses.window, y: int, x: int, h: int, w: int, title: str) -> None:
    stdscr.attron(curses.color_pair(2))
    try:
        curses.textpad.rectangle(stdscr, y, x, y + h - 1, x + w - 1)
    except curses.error:
        pass
    stdscr.attroff(curses.color_pair(2))
    add_text(stdscr, y, x + 2, f" {title} ", curses.color_pair(3) | curses.A_BOLD)


def add_text(stdscr: curses.window, y: int, x: int, text: str, attr: int = 0) -> None:
    max_y, max_x = stdscr.getmaxyx()
    if y < 0 or y >= max_y or x < 0 or x >= max_x:
        return
    try:
        stdscr.addnstr(y, x, text, max_x - x - 1, attr)
    except curses.error:
        pass


def add_rows(stdscr: curses.window, y: int, x: int, rows: Iterable[str], limit: int) -> None:
    for offset, row in enumerate(list(rows)[:limit]):
        add_text(stdscr, y + offset, x, row)


def draw(stdscr: curses.window) -> None:
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_CYAN, -1)
    curses.init_pair(3, curses.COLOR_YELLOW, -1)
    stdscr.nodelay(True)
    stdscr.timeout(100)

    while True:
        key = stdscr.getch()
        if key in (ord("q"), ord("Q"), 27):
            break

        stdscr.erase()
        max_y, max_x = stdscr.getmaxyx()
        now = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        title = f"System-Monitor-NNK  {now}  refresh={REFRESH_SECONDS:.0f}s  q=quit"
        add_text(stdscr, 0, 2, title[: max_x - 4], curses.color_pair(1) | curses.A_BOLD)

        if max_y < 20 or max_x < 78:
            add_text(stdscr, 2, 2, "Terminal too small. Resize to at least 78x20.")
            stdscr.refresh()
            time.sleep(REFRESH_SECONDS)
            continue

        left_w = max_x // 2 - 2
        right_x = left_w + 3
        right_w = max_x - right_x - 1

        identity = get_identity()
        memory = get_memory()
        ssh_connections = get_ssh_connections()
        users = get_logged_in_users()

        draw_box(stdscr, 2, 1, 8, left_w, "Host")
        host_rows = [f"{key}: {value}" for key, value in identity.items()]
        host_rows.extend([f"Load avg: {get_load()}", f"Disk /: {get_disk()}"])
        add_rows(stdscr, 3, 3, host_rows, 6)

        draw_box(stdscr, 2, right_x, 8, right_w, "Memory And Power")
        resource_rows = [f"{key}: {value}" for key, value in memory.items()]
        resource_rows.extend([f"Power draw: {get_power_draw()}", f"Power mode: {get_power_mode()}"])
        add_rows(stdscr, 3, right_x + 2, resource_rows, 6)

        draw_box(stdscr, 11, 1, 7, left_w, "SSH Connections")
        if ssh_connections:
            rows = [f"{conn.remote} -> {conn.local} {conn.process}" for conn in ssh_connections]
        else:
            rows = ["No established SSH TCP sessions found."]
        add_rows(stdscr, 12, 3, rows, 5)

        draw_box(stdscr, 11, right_x, 7, right_w, "Logged-In Sessions")
        add_rows(stdscr, 12, right_x + 2, users or ["No active login sessions found."], 5)

        lower_h = max_y - 19
        if lower_h >= 5:
            draw_box(stdscr, 18, 1, lower_h, left_w, "Temperatures")
            add_rows(stdscr, 19, 3, get_temperatures() or ["No thermal zone data found."], lower_h - 2)

            draw_box(stdscr, 18, right_x, lower_h, right_w, "Top CPU Processes")
            add_rows(stdscr, 19, right_x + 2, get_process_snapshot(), lower_h - 2)

        stdscr.refresh()
        time.sleep(REFRESH_SECONDS)


def main() -> int:
    try:
        curses.wrapper(draw)
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
